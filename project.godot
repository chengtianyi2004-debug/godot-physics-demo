; Godot Engine project configuration.
config_version=5

[application]

config/name="Анимация и физика"
run/main_scene="res://lab.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[input]

toggle_animation={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
drop_balls={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
launch_ball={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194321)]
}
reset_lab={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":82)]
}

[physics]

2d/default_gravity=980.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.925, 0.933, 0.945, 1)
